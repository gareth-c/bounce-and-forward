# --- SMTP daemon ---
# Port 25 needs root or CAP_NET_BIND_SERVICE (see README). Use a high port like 2525 for local testing.
SMTP_PORT=2525
SMTP_HOST=0.0.0.0
# Banner shown on connect.
SMTP_BANNER=mail.example.com ESMTP
# Max accepted message size in bytes (default 25MB).
SMTP_MAX_SIZE=26214400

# Comma-separated list of recipients this server accepts mail for, before capturing+bouncing it.
# Entries can be full addresses (alice@example.com) or bare domains (@example.com) to match every
# address at that domain. Anything not matched here is rejected immediately at RCPT TO with 550
# and never stored.
#
# This is ONLY used to seed the allow-list the first time the server starts (into the database).
# After that, manage the list from the web UI at /recipients — this env var is ignored on
# subsequent restarts, so editing it later has no effect.
ALLOWED_RECIPIENTS=alice@example.com,@example.org

# SMTP response sent after the message is fully captured, instead of "250 OK". Must be 5xx to be
# treated as a permanent failure (so the sender's MTA generates a real bounce back to them).
BOUNCE_CODE=550
BOUNCE_MESSAGE=5.7.1 Message not accepted for delivery

# --- Web UI ---
WEB_PORT=8080
WEB_HOST=127.0.0.1
WEB_USERNAME=admin
# Generate with: npm run hash-password -- 'your-password-here'
WEB_PASSWORD_HASH=
# Random long string, e.g. `openssl rand -hex 32`.
SESSION_SECRET=change-me-to-a-random-value
# Set to true only when the web UI is served over HTTPS (e.g. behind a TLS reverse proxy).
WEB_SECURE_COOKIES=false
# Set to true ONLY when running behind a reverse proxy (Caddy/nginx) that sets X-Forwarded-*
# headers itself. If true with no real proxy in front, clients could spoof those headers directly.
WEB_TRUST_PROXY=false

# --- Storage ---
DATA_DIR=./data

# Storage quota (GB) and retention (days) for captured mail. Enforced after every capture and
# swept hourly: messages past the retention window are deleted regardless of quota, and if still
# over quota, the oldest remaining messages are deleted until back under it.
#
# Like ALLOWED_RECIPIENTS, these ONLY seed the database the first time the server starts. After
# that, manage them from the web UI at /settings — editing these env vars later has no effect.
STORAGE_QUOTA_GB=5
RETENTION_DAYS=365
