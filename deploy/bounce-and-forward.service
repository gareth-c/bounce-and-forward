[Unit]
Description=Bounce & Forward SMTP capture daemon
After=network.target

[Service]
Type=simple
User=bounceforward
Group=bounceforward
WorkingDirectory=/opt/bounce-and-forward
EnvironmentFile=/opt/bounce-and-forward/.env
ExecStart=/usr/bin/node /opt/bounce-and-forward/src/index.js
Restart=on-failure
RestartSec=5

# Lets a non-root service user bind to port 25 without running as root, and
# strips every other capability from the process (including ones root's
# default bounding set would otherwise leave available to it).
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# Light sandboxing. ReadWritePaths must cover DATA_DIR from .env.
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/bounce-and-forward/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
