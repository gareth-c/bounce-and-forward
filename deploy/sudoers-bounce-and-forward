# Lets the deploy SSH user run ONLY the redeploy script as root, without a
# password, instead of granting it blanket sudo. If the GitHub Actions
# EC2_SSH_KEY secret ever leaks, this limits what it can do on the box.
#
# Install as /etc/sudoers.d/bounce-and-forward (owned by root, mode 0440):
#   sudo cp deploy/sudoers-bounce-and-forward /etc/sudoers.d/bounce-and-forward
#   sudo chown root:root /etc/sudoers.d/bounce-and-forward
#   sudo chmod 0440 /etc/sudoers.d/bounce-and-forward
#   sudo visudo -c   # validate syntax before relying on it
#
# Replace "deploy" below with the actual SSH login user (EC2_USER secret).
# The script must be invoked directly (not via "bash deploy.sh") so sudo
# matches on its own path rather than on /bin/bash.
deploy ALL=(root) NOPASSWD: /opt/bounce-and-forward/deploy/deploy.sh *
