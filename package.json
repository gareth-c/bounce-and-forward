{
  "name": "bounce-and-forward",
  "version": "1.0.0",
  "description": "SMTP daemon that accepts mail for configured users/domains, captures it, then bounces it with a permanent SMTP error. Captured mail is viewable in a password-protected web UI.",
  "type": "commonjs",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "hash-password": "node bin/hash-password.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "mailparser": "^3.7.1",
    "smtp-server": "^3.13.4"
  }
}
